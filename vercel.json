{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/roma", "destination": "/guias/roma", "permanent": true },
    { "source": "/madrid", "destination": "/guias/madrid", "permanent": true },
    { "source": "/miami", "destination": "/guias/miami", "permanent": true },
    { "source": "/rio", "destination": "/guias/rio-de-janeiro", "permanent": true },
    { "source": "/bariloche", "destination": "/guias/bariloche-patagonia", "permanent": true },
    { "source": "/cancun", "destination": "/guias/cancun-riviera-maya", "permanent": true },
    { "source": "/mendoza", "destination": "/guias/mendoza-valle-de-uco", "permanent": true },
    { "source": "/iguazu", "destination": "/guias/puerto-iguazu-cataratas", "permanent": true },
    { "source": "/paris", "destination": "/guias/paris-ile-de-france", "permanent": true },
    { "source": "/londres", "destination": "/guias/londres-reino-unido", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://flagcdn.com https://images.unsplash.com https://thumb.wikimedia.org https://upload.wikimedia.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.flightbot.com.ar"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        }
      ]
    }
  ]
}
